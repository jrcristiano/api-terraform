services:
  nginx:
    image: nginx:alpine
    ports:
      - "{{ app_port }}:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - api
    restart: unless-stopped

  api:
    image: "{{ ecr_repository_url }}:{{ image_tag }}"
    environment:
      - PORT=3000
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api/posts"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
